---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { topics } from '../../data/topics';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const counts = new Map<string, number>();
for (const p of posts) counts.set(p.data.topic, (counts.get(p.data.topic) ?? 0) + 1);
---

<BaseLayout
  title="Chủ đề"
  description="Các chủ đề của LearnWithHuy: AI cơ bản, Generative AI và LLM, Prompt Engineering, Công cụ AI, Machine Learning, lập trình, AI trong công việc và xu hướng công nghệ."
>
  <div class="container">
    <header class="page-head">
      <h1>Chủ đề</h1>
      <p class="lead">
        Nội dung được tổ chức thành 8 chủ đề, từ khái niệm nền tảng cho đến ứng dụng thực tế.
        Chọn một chủ đề để bắt đầu.
      </p>
    </header>

    <section class="section" style="padding-top: 1.5rem;">
      <div class="topic-grid">
        {topics.map((t) => (
          <a class="topic-card" href={`/chu-de/${t.slug}/`}>
            <h2 class="topic-card__name">{t.name}</h2>
            <p class="topic-card__desc">{t.description}</p>
            <span class="topic-card__count">{counts.get(t.slug) ?? 0} bài viết</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
