---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Không tìm thấy trang">
  <div class="container">
    <div class="empty-state" style="margin-block: 5rem;">
      <div class="icon" aria-hidden="true">🧭</div>
      <h1 style="font-size: 1.6rem;">Không tìm thấy trang này</h1>
      <p>
        Trang bạn đang tìm không tồn tại hoặc đã được di chuyển.
        Thử tìm bài viết khác nhé.
      </p>
      <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
        <a class="btn btn--primary" href="/">Về trang chủ</a>
        <a class="btn btn--outline" href="/bai-viet/">Xem bài viết</a>
      </div>
    </div>
  </div>
</BaseLayout>
