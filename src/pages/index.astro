---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { SITE } from '../config';
import { topics } from '../data/topics';
import { learningPaths, getPathPosts, pathReadingMinutes } from '../data/learning-paths';
import PathCard from '../components/PathCard.astro';
import { getPublishedPosts, getTopicOf, readingTime } from '../lib/posts';

const posts = await getPublishedPosts();
const featured = posts.filter((p) => p.data.featured).slice(0, 2);
const latest = posts.slice(0, 6);
const popularTopics = [...topics];

const CAM_NANG_SLUGS = [
  'chuong-trinh-harness-engineer',
  'claude-cho-doanh-nghiep',
  'kien-truc-ai-agent-cam-nang',
  'meridian-rag-multimodal',
  'rag-nang-cao-cam-nang',
  'openclaw-cam-nang',
  'tieng-anh-cho-dan-ai-cam-nang',
  'hermes-agent-9router',
];
const camNangs = CAM_NANG_SLUGS.map((slug) => posts.find((p) => p.id === slug)).filter(Boolean);

const goals = [
  {
    icon: '🌱',
    title: 'Tôi mới tìm hiểu AI',
    desc: '5 bài nền tảng, không cần biết lập trình — hiểu AI vận hành ra sao và bắt tay dùng thử.',
    href: '/lo-trinh/nhap-mon-ai/',
    cta: 'Lộ trình nhập môn',
  },
  {
    icon: '💼',
    title: 'Tôi muốn dùng AI trong công việc',
    desc: 'Viết prompt rõ ràng, dùng công cụ đúng cách và dựng hệ thống cho đội nhóm.',
    href: '/lo-trinh/ai-cho-cong-viec/',
    cta: 'Lộ trình công việc',
  },
  {
    icon: '🛠️',
    title: 'Tôi muốn xây ứng dụng AI',
    desc: 'Từ agent loop đầu tiên đến harness production — cho người có nền tảng kỹ thuật.',
    href: '/lo-trinh/ai-agent-engineer/',
    cta: 'Lộ trình AI Engineer',
  },
];

const counts = new Map<string, number>();
for (const p of posts) counts.set(p.data.topic, (counts.get(p.data.topic) ?? 0) + 1);
const postsPerTopic = (slug: string) => counts.get(slug) ?? 0;

const pathCards = await Promise.all(
  learningPaths.map(async (path) => {
    const pathPosts = await getPathPosts(path);
    return { path, minutes: pathReadingMinutes(path, pathPosts), lessonCount: pathPosts.length };
  }),
);
---

<BaseLayout title={`${SITE.name} — Blog học AI và công nghệ cùng Huy`}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Blog cá nhân về AI & công nghệ</span>
        <h1>Cùng Huy học AI và công nghệ, từng bước một</h1>
        <p class="lead">
          Kiến thức dễ hiểu, ví dụ thực tế, ứng dụng được ngay. Viết cho người mới bắt đầu,
          không đòi hỏi nền tảng lập trình.
        </p>
        <div class="hero-cta">
          <a class="btn btn--primary" href="/bai-viet/">Khám phá bài viết</a>
          <a class="btn btn--outline" href="/chu-de/ai-co-ban/">Bắt đầu học AI</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <img src="/images/covers/posts/_hero.jpg" alt="" width="1200" height="900" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- Bắt đầu theo mục tiêu -->
  <section class="section section--alt" aria-labelledby="goals-h">
    <div class="container">
      <div class="section-head">
        <h2 id="goals-h">Bắt đầu theo mục tiêu của bạn</h2>
        <a class="see-all" href="/lo-trinh/">Tất cả lộ trình →</a>
      </div>
      <div class="goal-grid">
        {goals.map((g) => (
          <a class="goal-card" href={g.href}>
            <span class="goal-card__icon" aria-hidden="true">{g.icon}</span>
            <h3 class="goal-card__title">{g.title}</h3>
            <p class="goal-card__desc">{g.desc}</p>
            <span class="goal-card__cta">{g.cta} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bài viết nổi bật -->
  <section class="section" aria-labelledby="featured-h">
    <div class="container">
      <div class="section-head">
        <h2 id="featured-h">Bài viết nổi bật</h2>
        <a class="see-all" href="/bai-viet/?sap-xep=pho-bien">Xem theo độ phổ biến →</a>
      </div>
      <div class="post-grid post-grid--2">
        {featured.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>

  <!-- Lộ trình học -->
  <section class="section" aria-labelledby="paths-h">
    <div class="container">
      <div class="section-head">
        <h2 id="paths-h">Lộ trình học</h2>
        <a class="see-all" href="/lo-trinh/">Xem tất cả lộ trình →</a>
      </div>
      <p class="paths-intro">
        Bài học được sắp theo thứ tự từ nền tảng đến nâng cao theo từng chủ đề — học đúng
        trình tự thay vì đọc bài rời rạc.
      </p>
      <div class="path-grid-home">
        {pathCards.map((c) => <PathCard path={c.path} minutes={c.minutes} lessonCount={c.lessonCount} />)}
      </div>
    </div>
  </section>

  <!-- Bài viết mới nhất -->
  <section class="section" aria-labelledby="latest-h">
    <div class="container">
      <div class="section-head">
        <h2 id="latest-h">Bài viết mới nhất</h2>
        <a class="see-all" href="/bai-viet/">Xem tất cả →</a>
      </div>
      <div class="post-grid">
        {latest.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>

  <!-- Chuyên sâu: cẩm nang toàn tập -->
  {camNangs.length > 0 && (
  <section class="section section--alt" aria-labelledby="camnang-h">
    <div class="container">
      <div class="section-head">
        <h2 id="camnang-h">Chuyên sâu: cẩm nang toàn tập</h2>
        <a class="see-all" href="/bai-viet/">Xem tất cả bài viết →</a>
      </div>
      <p class="paths-intro">
        Mỗi cẩm nang gộp trọn một chương trình trong một trang — có mục lục, thời gian đọc từng
        phần, phù hợp đọc tuần tự hoặc tra cứu theo phần.
      </p>
      <div class="post-grid">
        {camNangs.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>
  )}

  <!-- Chủ đề phổ biến -->
  <section class="section" aria-labelledby="topics-h">
    <div class="container">
      <div class="section-head">
        <h2 id="topics-h">Chủ đề phổ biến</h2>
        <a class="see-all" href="/chu-de/">Tất cả chủ đề →</a>
      </div>
      <div class="topic-grid">
        {popularTopics.map((t) => (
          <a class="topic-card" href={`/chu-de/${t.slug}/`}>
            <h3 class="topic-card__name">{t.name}</h3>
            <p class="topic-card__desc">{t.description}</p>
            <span class="topic-card__count">{postsPerTopic(t.slug)} bài viết</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bản tin -->
  <section class="section">
    <div class="container container--narrow">
      <NewsletterForm variant="band" title="Đồng hành cùng LearnWithHuy qua bản tin" />
    </div>
  </section>
</BaseLayout>

<style>
  .paths-intro {
    margin: -0.75rem 0 1.25rem;
    color: var(--muted);
    font-size: 0.98rem;
  }
  .path-grid-home {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .goal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .goal-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.35rem 1.35rem 1.15rem;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .goal-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .goal-card__icon {
    font-size: 1.5rem;
    line-height: 1;
  }
  .goal-card__title {
    font-size: 1.05rem;
    margin: 0;
  }
  .goal-card__desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
    flex: 1;
  }
  .goal-card__cta {
    font-weight: 600;
    color: var(--accent);
    font-size: 0.92rem;
  }
</style>
