---
import type { Post } from '../lib/posts';
import { formatDate, getTopicOf, readingTime } from '../lib/posts';

interface Props {
  post: Post;
  /** Không hiển thị chip chủ đề (vd: đang lọc theo chủ đề rồi) */
  hideTopic?: boolean;
}

const { post, hideTopic = false } = Astro.props;
const topic = getTopicOf(post);
const read = readingTime(post.body ?? '');
---

<article class="post-card">
  <a class="post-card__media" href={`/bai-viet/${post.id}/`} aria-hidden="true" tabindex="-1">
    <img src={post.data.cover} alt="" width="1200" height="675" loading="lazy" decoding="async" />
  </a>
  <div class="post-card__body">
    <div style="display:flex; gap:0.4rem; align-items:center;">
      {!hideTopic && topic && (
        <a class="chip" href={`/chu-de/${topic.slug}/`}>{topic.name}</a>
      )}
      {post.data.featured && <span class="chip" style="background: var(--surface-2); color: var(--muted);">Nổi bật</span>}
    </div>
    <h2 class="post-card__title">
      <a href={`/bai-viet/${post.id}/`}>{post.data.title}</a>
    </h2>
    <p class="post-card__desc">{post.data.description}</p>
    <p class="post-card__meta">
      <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
      <span class="meta-dot" aria-hidden="true"></span>
      <span>{read} phút đọc</span>
    </p>
  </div>
</article>
