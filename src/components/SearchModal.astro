---
---

<div class="search-overlay" id="search-overlay" role="dialog" aria-modal="true" aria-label="Tìm kiếm bài viết" hidden>
  <div class="search-panel">
    <div class="search-input-row">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.8-3.8"></path>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Tìm theo tiêu đề hoặc nội dung bài viết…"
        autocomplete="off"
      />
      <button class="icon-btn" id="search-close" type="button" aria-label="Đóng tìm kiếm">✕</button>
    </div>
    <div class="search-results" id="search-results"></div>
  </div>
</div>

<script>
  // Tìm kiếm toàn cục — nạp chỉ mục /search-index.json lần đầu mở, lọc phía client.
  type PostIndex = { slug: string; title: string; description: string; topic: string; body: string };
  const TOPIC_NAMES: Record<string, string> = {
    'ai-co-ban': 'AI cơ bản',
    'generative-ai-llm': 'Generative AI và LLM',
    'prompt-engineering': 'Prompt Engineering',
    'cong-cu-ai': 'Công cụ AI',
    'machine-learning': 'Machine Learning',
    'lap-trinh-va-cong-nghe': 'Lập trình và công nghệ',
    'ai-trong-cong-viec': 'AI trong công việc',
    'goc-nhin-va-xu-huong': 'Góc nhìn và xu hướng công nghệ',
  };

  const overlay = document.getElementById('search-overlay')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const resultsBox = document.getElementById('search-results')!;
  const closeBtn = document.getElementById('search-close')!;

  let index: PostIndex[] | null = null;
  let indexPromise: Promise<PostIndex[]> | null = null;

  function loadIndex(): Promise<PostIndex[]> {
    if (index) return Promise.resolve(index);
    indexPromise ??= fetch('/search-index.json')
      .then((r) => r.json())
      .catch(() => []);
    return indexPromise.then((data) => { index = data; return data; });
  }

  function renderResults(list: PostIndex[], query: string) {
    if (!query.trim()) {
      resultsBox.innerHTML =
        '<p class="search-empty">Gõ từ khóa để tìm trong tiêu đề và nội dung bài viết.</p>';
      return;
    }
    if (!list.length) {
      resultsBox.innerHTML =
        `<p class="search-empty">Không tìm thấy bài nào cho “${query}”.<br/>Thử từ khóa khác xem sao?</p>`;
      return;
    }
    resultsBox.innerHTML = list
      .map(
        (p) => `
        <a class="search-result" href="/bai-viet/${p.slug}/">
          <span class="sr-topic">${TOPIC_NAMES[p.topic] ?? p.topic}</span>
          <p class="sr-title">${p.title}</p>
          <p class="sr-desc">${p.description}</p>
        </a>`
      )
      .join('');
  }

  function open() {
    overlay.hidden = false;
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    loadIndex();
    input.value = '';
    renderResults([], '');
    input.focus();
  }

  function close() {
    overlay.classList.remove('open');
    overlay.hidden = true;
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.js-open-search').forEach((btn) =>
    btn.addEventListener('click', open)
  );
  closeBtn.addEventListener('click', close);
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      overlay.hidden ? open() : close();
    }
    if (e.key === 'Escape' && !overlay.hidden) close();
  });

  let debounce: number | undefined;
  input.addEventListener('input', () => {
    window.clearTimeout(debounce);
    debounce = window.setTimeout(async () => {
      const q = input.value.trim().toLowerCase();
      const posts = await loadIndex();
      if (!q) return renderResults(posts, '');
      const filtered = posts.filter(
        (p) =>
          p.title.toLowerCase().includes(q) ||
          p.description.toLowerCase().includes(q) ||
          p.body.toLowerCase().includes(q)
      );
      renderResults(filtered, input.value.trim());
    }, 120);
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
