---

const path = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Trang chủ' },
  { href: '/bai-viet/', label: 'Bài viết' },
  { href: '/lo-trinh/', label: 'Lộ trình' },
  { href: '/chu-de/', label: 'Chủ đề' },
  { href: '/ve-huy/', label: 'Về Huy' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container inner">
    <a class="logo" href="/">LearnWith<em>Huy</em></a>

    <nav class="main-nav" id="main-nav" aria-label="Điều hướng chính">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="search-btn js-open-search" type="button" aria-label="Tìm kiếm bài viết">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.8-3.8"></path>
        </svg>
        <span class="search-label">Tìm kiếm</span>
        <kbd>⌘K</kbd>
      </button>

      <a class="btn btn--primary btn--small header-subscribe" href="/#dang-ky-ban-tin">Nhận bản tin</a>

      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Đổi giao diện sáng/tối">
        <svg class="icon-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none;">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <button class="icon-btn menu-toggle" id="menu-toggle" type="button" aria-label="Mở menu" aria-expanded="false" aria-controls="main-nav">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Nút đổi theme — lưu lựa chọn vào localStorage.
  const toggle = document.getElementById('theme-toggle');
  const sun = toggle?.querySelector<SVGElement>('.icon-sun');
  const moon = toggle?.querySelector<SVGElement>('.icon-moon');

  function syncIcon() {
    const dark = document.documentElement.dataset.theme === 'dark';
    if (sun && moon) {
      sun.style.display = dark ? 'none' : '';
      moon.style.display = dark ? '' : 'none';
    }
  }
  syncIcon();

  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('lwh-theme', next); } catch {}
    syncIcon();
  });

  // Menu trên màn hình nhỏ.
  const menuBtn = document.getElementById('menu-toggle');
  const nav = document.getElementById('main-nav');
  menuBtn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    menuBtn.setAttribute('aria-expanded', String(!!open));
    menuBtn.setAttribute('aria-label', open ? 'Đóng menu' : 'Mở menu');
  });
</script>
